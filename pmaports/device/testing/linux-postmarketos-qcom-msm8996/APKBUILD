# Kernel config based on: arch/arm64/configs/defconfig
# Contributor: Yassine Oudjana (Tooniis) <y.oudjana@protonmail.com>
# Based on pmaports device/testing/linux-postmarketos-qcom-msm8996 (v26.06), plus
# the series in patches/kernel/ of this repository.
maintainer="Tommaso Sacchetti"
_flavor="postmarketos-qcom-msm8996"
pkgname=linux-$_flavor
pkgver=6.19.5
pkgrel=100
pkgdesc="Kernel close to mainline with extra patches for Qualcomm MSM8996 devices"
arch="aarch64"
_carch="arm64"
url="https://gitlab.com/msm8996-mainline/linux"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native
	pmb:kconfigcheck-community
"
makedepends="
	bison
	clang
	findutils
	flex
	installkernel
	lld
	llvm
	openssl-dev
	perl
	python3
	zstd
"

# Source
_tag=v${pkgver//_/-}-msm8996
source="
	linux-$_tag.tar.gz::$url/-/archive/$_tag/linux-$_tag.tar.gz
	config-$_flavor.$arch
	0001-power-supply-qcom_fg-initialise-SRAM-state-before-re.patch
	0002-backlight-qcom-wled-do-not-enable-the-OVP-IRQ-twice.patch
	0003-arm64-dts-msm8996-add-the-APSS-watchdog.patch
	0004-arm64-dts-msm8996-mark-the-CPU-power-collapse-state-.patch
	0005-arm64-dts-msm8996-xiaomi-gemini-enable-the-USB-PHY-r.patch
	0006-arm64-dts-msm8996-xiaomi-gemini-describe-the-two-wir.patch
	0007-drm-panel-add-LG-Display-TD4322-command-mode-panel-d.patch
	0008-arm64-dts-qcom-add-msm8996-xiaomi-gemini-lgd-for-LG-.patch
	0009-power-supply-qcom-smbchg-add-charge_behaviour-inhibi.patch
"
builddir="$srcdir/linux-$_tag"

prepare() {
	default_prepare
	cp "$srcdir/config-$_flavor.$CARCH" .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$_flavor"
}

package() {
	install -Dm644 "$builddir/arch/$_carch/boot/Image.gz" \
		"$pkgdir/boot/vmlinuz"

	install -D "$builddir/include/config/kernel.release" \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"

	make modules_install dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_MOD_PATH="$pkgdir" \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
}
