From e274e8ac258ce760362781f67d8318154b02e0e5 Mon Sep 17 00:00:00 2001
From: Tommaso Sacchetti <noreply@example.invalid>
Date: Tue, 27 Oct 2026 15:36:38 +0100
Subject: [PATCH] arm64: dts: msm8996-xiaomi-gemini: describe the two wired
 WLED strings

Only two of the four WLED strings are wired up on this board. With the
driver defaults the unused strings look open, the boost converter hits
its OVP threshold and the OVP interrupt fires about 25000 times a
second, which keeps a CPU busy and heats the phone.

Describe the enabled strings and the current, boost, OVP and frequency
limits, taken from the downstream qpnp-wled node.

Signed-off-by: Tommaso Sacchetti
---
 arch/arm64/boot/dts/qcom/msm8996-xiaomi-gemini.dts | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/msm8996-xiaomi-gemini.dts b/arch/arm64/boot/dts/qcom/msm8996-xiaomi-gemini.dts
index 0236b60..f21283f 100644
--- a/arch/arm64/boot/dts/qcom/msm8996-xiaomi-gemini.dts
+++ b/arch/arm64/boot/dts/qcom/msm8996-xiaomi-gemini.dts
@@ -143,6 +143,17 @@
 };
 
 &pmi8994_wled {
+	/*
+	 * Only two of the four WLED strings are wired up on this board. With the
+	 * driver defaults (four strings) the unused strings look open, the boost
+	 * converter hits its OVP threshold and the OVP interrupt storms (about
+	 * 25k/s), heating the phone. Values match the downstream qpnp-wled node.
+	 */
+	qcom,enabled-strings = <0 1>;
+	qcom,current-boost-limit = <970>;
+	qcom,current-limit-microamp = <20000>;
+	qcom,ovp-millivolt = <29500>;
+	qcom,switching-freq = <600>;
 	status = "okay";
 };
 
