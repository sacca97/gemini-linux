From 55cb511af4943a4eba948778f5d61a6eb80545f3 Mon Sep 17 00:00:00 2001
From: Tommaso Sacchetti <noreply@example.invalid>
Date: Tue, 27 Oct 2026 15:36:12 +0100
Subject: [PATCH] power: supply: qcom_fg: initialise SRAM state before
 registering the supply

Registering the battery power supply can immediately read the battery
temperature through the thermal zone, which uses the SRAM locks,
completions and request counter. Those were only initialised after the
registration, so on MSM8996 (Xiaomi Mi 5) the first read hit a WARN on
sram_requests == -1 in qcom_fg_sram_read().

Initialise the SRAM state first, then register the supply and read the
battery info.

Signed-off-by: Tommaso Sacchetti
---
 drivers/power/supply/qcom_fg.c | 42 +++++++++++++++++++---------------
 1 file changed, 23 insertions(+), 19 deletions(-)

diff --git a/drivers/power/supply/qcom_fg.c b/drivers/power/supply/qcom_fg.c
index db45f74..153875e 100644
--- a/drivers/power/supply/qcom_fg.c
+++ b/drivers/power/supply/qcom_fg.c
@@ -1137,25 +1137,11 @@ static int qcom_fg_probe(struct platform_device *pdev)
 		return ret;
 	}
 
-	supply_config.drv_data = chip;
-	supply_config.fwnode = dev_fwnode(&pdev->dev);
-
-	chip->batt_psy = devm_power_supply_register(chip->dev,
-			&batt_psy_desc, &supply_config);
-	if (IS_ERR(chip->batt_psy)) {
-		dev_err(&pdev->dev, "Failed to register battery\n");
-		return PTR_ERR(chip->batt_psy);
-	}
-
-	platform_set_drvdata(pdev, chip);
-
-	ret = power_supply_get_battery_info(chip->batt_psy, &chip->batt_info);
-	if (ret) {
-		dev_err(&pdev->dev, "Failed to get battery info: %d\n", ret);
-		return ret;
-	}
-
-	/* Initialize SRAM if available */
+	/*
+	 * Initialize SRAM state before registering the power supply: registering
+	 * it can trigger an immediate thermal-zone temperature read, which uses
+	 * the SRAM locks, completions and request counter.
+	 */
 	if (chip->sram_regs) {
 		irq = of_irq_get_byname(pdev->dev.of_node, "mem-avail");
 		if (irq < 0) {
@@ -1184,6 +1170,24 @@ static int qcom_fg_probe(struct platform_device *pdev)
 		chip->sram_requests = 0;
 	}
 
+	supply_config.drv_data = chip;
+	supply_config.fwnode = dev_fwnode(&pdev->dev);
+
+	chip->batt_psy = devm_power_supply_register(chip->dev,
+			&batt_psy_desc, &supply_config);
+	if (IS_ERR(chip->batt_psy)) {
+		dev_err(&pdev->dev, "Failed to register battery\n");
+		return PTR_ERR(chip->batt_psy);
+	}
+
+	platform_set_drvdata(pdev, chip);
+
+	ret = power_supply_get_battery_info(chip->batt_psy, &chip->batt_info);
+	if (ret) {
+		dev_err(&pdev->dev, "Failed to get battery info: %d\n", ret);
+		return ret;
+	}
+
 	/* Set default temperature thresholds */
 	if (chip->ops->set_temp_threshold) {
 		ret = chip->ops->set_temp_threshold(chip,
